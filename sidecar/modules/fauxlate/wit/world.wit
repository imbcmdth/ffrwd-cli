package ffrwd:fauxlate;

/// One word rule, reached two ways: `translate` as a value function, one
/// string in and one out, and `translate-rows` as a rows module, running the
/// same rule over a cue's `text` field. No imports - the rule is pure.
world fauxlate {
  export ffrwd:av/values@0.15.0;
  export ffrwd:av/rows-module@0.15.0;
}
