      },
      "inputs": [
        "n5"
      ],
      "outputs": [
        "audio"
      ]
    },
    {
      "id": "n7",
      "filter": "amix",
      "args": {
        "inputs": 2
      },
      "inputs": [
        "src:f:a:0",
        "n6"
      ],
      "outputs": [
        "audio"
      ]
    }
  ],
  "sinks": [
    {
      "outputs": [
        {
          "ref": "n4",
