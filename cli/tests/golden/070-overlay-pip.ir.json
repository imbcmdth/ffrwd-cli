{
  "inputs": [
    "main.mp4",
    "logo.mp4"
  ],
  "sources": {
    "a": 0,
    "b": 1
  },
  "nodes": [
    {
      "id": "n1",
      "filter": "scale",
      "args": {
        "width": "iw*0.3"
      },
      "inputs": [
        "src:b:v:0"
      ],
      "outputs": [
        "video"
      ]
    },
    {
      "id": "n2",
      "filter": "overlay",
      "args": {
        "x": 50,
        "y": 50
      },
      "inputs": [
        "src:a:v:0",
        "n1"
      ],
      "outputs": [
        "video"
      ]
    }
  ],
  "sinks": [
    {
      "outputs": [
        {
          "ref": "n2",
          "type": "video",
          "name": null,
          "metadata": {}
        }
      ],
      "path": null,
      "options": {}
    }
  ]
}
